{
  "nexus-safety-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-prod-commands.mjs"
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/secret-scan.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .claude/hooks/run-tests.mjs"
      }
    ]
  }
}
