{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/application-prod.yml)",
      "Read(./**/application-prod.yaml)",
      "Read(./**/application-prod.properties)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(./.env*)",
      "Edit(./**/application-prod.*)",
      "Write(./.env*)",
      "Write(./**/application-prod.*)"
    ]
  },
  "hooks": {},
  "env": {
    "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8",
    "MAVEN_OPTS": "-Xmx2g"
  }
}