# Nexus — environment variable template
#
# Copy this file to `.env` (repo root) and fill in real values for your machine.
# `.env` is git-ignored and Claude Code's own tooling is configured to never read or
# write it (see .claude/settings.json) — treat it as yours alone, never commit it.
#
# Scope note: `application-dev.yml` already hardcodes dev-only placeholder values for
# the four "required, no default" Identity keys below, so running the backend under
# the `dev` Spring profile (`./mvnw spring-boot:run`) does NOT strictly need this file.
# This file matters when you run WITHOUT a profile, under `prod`, or via
# `docker compose --profile full` (which reads `.env` at the repo root for the two
# COMPOSE-LEVEL vars, and passes the rest through to the backend container).
#
# Only variables actually referenced in code are listed — nothing here is invented.

# ── Database (application.yml) ──────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/nexus?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# ── Docker Compose only (read directly by docker-compose.yml, not by Spring) ─
# Root MySQL bootstrap password — dev-only value, change for any shared environment.
MYSQL_ROOT_PASSWORD=root
# Password for the least-privilege `nexus_app` runtime DB user (ADR-0012).
NEXUS_APP_DB_PASSWORD=nexus_app_dev_only

# ── Backend — server / mail (application.yml) ───────────────────────────────
SERVER_PORT=1000
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Identity — encryption / hashing (application.yml) ───────────────────────
# All four below are REQUIRED with no default outside the `dev` profile — the app
# fails to boot if unset. Generate real values per environment; never reuse examples.
# AES-256-GCM master password, >= 16 chars.
NEXUS_IDENTITY_ENCRYPTION_PASSWORD=
# Hex KDF salt, >= 32 hex chars.
NEXUS_IDENTITY_ENCRYPTION_SALT=
# HMAC-SHA256 key for the email blind index, >= 32 bytes.
NEXUS_IDENTITY_HMAC_KEY=
# Bootstrap tenant UUID (v7). Must match the tenant seeded into the target DB
# (e.g. RBAC seed data in V5__rbac_schema.sql uses 00000000-0000-7000-8000-000000000001).
NEXUS_IDENTITY_DEFAULT_TENANT_ID=

# ── Identity — Argon2 password hashing (application.yml) ────────────────────
NEXUS_ARGON2_MEMORY_KB=19456
NEXUS_ARGON2_ITERATIONS=2
NEXUS_ARGON2_PARALLELISM=1

# ── Identity — JWT signing keys (application.yml) ───────────────────────────
# RSA-2048+ PKCS#8 PEM. Leave blank in dev to use an ephemeral generated key
# (tokens won't survive a restart); set a real key pair for any shared environment.
NEXUS_JWT_PRIVATE_KEY_PEM=
NEXUS_JWT_PUBLIC_KEY_PEM=

# ── Identity — misc (application.yml) ───────────────────────────────────────
NEXUS_MAIL_FROM_ADDRESS=noreply@nexus.example.com
NEXUS_FRONTEND_BASE_URL=http://localhost:2000
FEATURE_AUTH_REGISTRATION_ENABLED=false

# ── Frontend ─────────────────────────────────────────────────────────────────
# None. nexus-frontend has no runtime env vars — Angular environment switching is
# build-time file replacement (environment.ts / environment.development.ts), not
# process.env / import.meta.env. Nothing to configure here.
