<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">

    <configuration>
        <!-- turn cache on -->
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <validateXml>true</validateXml>

        <!-- optional: only allow storing after a clean build -->
        <!-- <mandatoryClean>true</mandatoryClean> -->

        <!-- local cache settings (default location is ~/.m2/build-cache/) -->
        <local>
            <!-- <location>/custom/cache/location</location> -->
            <maxBuildsCached>3</maxBuildsCached>
        </local>

        <!-- disable remote cache: local-only mode -->
        <remote enabled="false"/>
    </configuration>

    <!-- keep inputs simple to start – you can refine later -->
    <input>
        <global>
            <!-- Example: exclude docs or other noise from checksum, optional -->
            <!--
            <excludes>
              <exclude>src/main/doc</exclude>
            </excludes>
            -->
        </global>
    </input>

</cache>
