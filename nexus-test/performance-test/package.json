{
  "name": "nexus-performance-test",
  "version": "0.0.0",
  "private": true,
  "description": "k6 performance tests for Nexus. k6 is a separate binary; npm is only a script runner and formatter.",
  "scripts": {
    "test:smoke": "k6 run --no-usage-report --summary-export=results/smoke-platform-health.json tests/smoke/platform-health.js",
    "test:smoke:user-profile": "k6 run --no-usage-report --summary-export=results/smoke-user-profile.json tests/smoke/user-profile.js",
    "test:load": "k6 run --no-usage-report --summary-export=results/load-platform-health.json tests/load/platform-health.js",
    "test:stress": "k6 run --no-usage-report --summary-export=results/stress-platform-health.json tests/stress/platform-health.js",
    "test:spike": "k6 run --no-usage-report --summary-export=results/spike-platform-health.json tests/spike/platform-health.js",
    "test:soak": "k6 run --no-usage-report --summary-export=results/soak-platform-health.json tests/soak/platform-health.js",
    "inspect": "bash scripts/inspect-tests.sh",
    "wait-for-ready": "bash scripts/wait-for-ready.sh",
    "format": "prettier --write \"{config,scenarios,thresholds,utils,workloads,tests}/**/*.js\"",
    "format:check": "prettier --check \"{config,scenarios,thresholds,utils,workloads,tests}/**/*.js\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "packageManager": "npm@11.6.2",
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
