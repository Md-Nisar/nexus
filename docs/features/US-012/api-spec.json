{
  "openapi": "3.1.0",
  "info": {
    "title": "Nexus API",
    "description": "Nexus platform REST API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:1000",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Self-service password reset"
    },
    {
      "name": "Role Assignment",
      "description": "Tenant-scoped role assignment and revocation"
    },
    {
      "name": "Authentication",
      "description": "Self-service registration and email verification"
    }
  ],
  "paths": {
    "/api/v1/users/{userId}/roles": {
      "get": {
        "tags": [
          "Role Assignment"
        ],
        "summary": "List the active role assignments held by a user within the caller's tenant",
        "operationId": "listRoles",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active role assignments",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed path UUID",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentListResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission or cross-tenant target",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentListResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Role Assignment"
        ],
        "summary": "Assign a role to a user within the caller's tenant",
        "operationId": "assignRole",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRoleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Assignment created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed path or body UUID",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing permission, cross-tenant target, or caller is not an active TENANT_ADMIN",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentResponse"
                }
              }
            }
          },
          "404": {
            "description": "User or role not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentResponse"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate active assignment",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RoleAssignmentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify an email address using the one-time token",
        "operationId": "verifyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Email verified successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                }
              }
            }
          },
          "410": {
            "description": "Token expired, already used, or not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyEmailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request a new verification email",
        "operationId": "resendVerification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Request accepted (anti-enumeration: same response whether account exists)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResendVerificationResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResendVerificationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user account",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Registration accepted (new or duplicate \u2014 identical response)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation or password policy failure",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "login-controller"
        ],
        "operationId": "refresh",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset password using the one-time reset token",
        "operationId": "resetPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPasswordResponse"
                }
              }
            }
          },
          "410": {
            "description": "Token expired, already used, or not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPasswordResponse"
                }
              }
            }
          },
          "400": {
            "description": "Password policy violation or same-as-current password",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ResetPasswordResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request a password-reset link via email",
        "operationId": "forgotPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Request accepted (anti-enumeration: same response whether account exists)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPasswordResponse"
                }
              }
            }
          },
          "400": {
            "description": "Structurally invalid request (blank or malformed email)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPasswordResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "login-controller"
        ],
        "operationId": "logout",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "login-controller"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me": {
      "get": {
        "tags": [
          "user-profile-controller"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "tags": [
          "jwks-controller"
        ],
        "operationId": "jwks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{userId}/roles/{roleId}": {
      "delete": {
        "tags": [
          "Role Assignment"
        ],
        "summary": "Revoke a role from a user within the caller's tenant",
        "operationId": "revokeRole",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "roleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Role revoked"
          },
          "400": {
            "description": "Malformed path UUID"
          },
          "403": {
            "description": "Missing permission or cross-tenant target"
          },
          "404": {
            "description": "User, role, or active assignment not found"
          },
          "409": {
            "description": "Would revoke the tenant's last active TENANT_ADMIN"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignRoleRequest": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "roleId"
        ]
      },
      "RoleAssignmentResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "roleId": {
            "type": "string"
          },
          "roleName": {
            "type": "string"
          },
          "assignedAt": {
            "type": "string",
            "format": "date-time"
          },
          "assignedBy": {
            "type": "string"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "pattern": "[0-9a-f]{64}"
          }
        },
        "required": [
          "token"
        ]
      },
      "VerifyEmailResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ResendVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "ResendVerificationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          "consentAccepted": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "string"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64
          },
          "newPassword": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0
          }
        },
        "required": [
          "newPassword",
          "token"
        ]
      },
      "ResetPasswordResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RoleAssignmentListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleAssignmentResponse"
            }
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "tenantId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tokenVersion": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}